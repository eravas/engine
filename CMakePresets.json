{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "host-headless",
      "displayName": "Host, headless (tests, scripted input, PPM dumps)",
      "inherits": "base",
      "cacheVariables": {
        "ENGINE_PLATFORM": "headless",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-sdl",
      "displayName": "Host, SDL3 window",
      "inherits": "base",
      "cacheVariables": {
        "ENGINE_PLATFORM": "sdl",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "rp2350",
      "displayName": "RP2350 (Pico SDK, compile-only stub backend)",
      "inherits": "base",
      "cacheVariables": {
        "ENGINE_PLATFORM": "rp2350",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-headless", "configurePreset": "host-headless" },
    { "name": "host-sdl", "configurePreset": "host-sdl" },
    { "name": "rp2350", "configurePreset": "rp2350" }
  ],
  "testPresets": [
    {
      "name": "host-headless",
      "displayName": "Everything that must pass",
      "configurePreset": "host-headless",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "todo" } }
    },
    {
      "name": "todo",
      "displayName": "Specifications of code not written yet",
      "configurePreset": "host-headless",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "todo" } }
    },
    {
      "name": "host-sdl",
      "displayName": "SDL smoke run on dummy drivers",
      "configurePreset": "host-sdl",
      "output": { "outputOnFailure": true }
    }
  ]
}
